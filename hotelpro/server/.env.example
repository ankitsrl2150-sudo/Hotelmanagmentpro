PORT=8001
MONGO_URI=mongodb://127.0.0.1:27017/hotelpro
JWT_SECRET=change_this_to_a_long_random_string
CLIENT_URL=http://localhost:5173

# Lets people pick "Staff" or "Admin" on the public sign-up form (matches the course project).
# Set to false in any real deployment; admins can create staff/admin accounts in User Management.
ALLOW_PRIVILEGED_SIGNUP=true

# If true, guests must click the emailed link before they can log in.
REQUIRE_EMAIL_VERIFICATION=false

# Optional SMTP. Without SMTP_HOST, emails are printed to the server console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=HotelPro <no-reply@hotelpro.local>
